rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // ===== USERS COLLECTION =====
    match /users/{userId} {
      // Users can read their own profile; admins can read any profile (needed for landlord/user management queries)
      allow read: if request.auth.uid == userId ||
                     (request.auth != null && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin');
      // Users can update their own profile
      allow update: if request.auth.uid == userId;
      // New users can create their profile
      allow create: if request.auth.uid == userId;
    }

    // ===== HOSTELS COLLECTION =====
    match /hostels/{hostelId} {
      // Anyone can read hostels (public listings)
      allow read: if true;
      // Only authenticated users can create hostels
      allow create: if request.auth != null;
      // Only the landlord who created it can update
      allow update: if request.auth.uid == resource.data.landlordId;
      // Only the landlord can delete
      allow delete: if request.auth.uid == resource.data.landlordId;
    }

    // ===== BOOKINGS COLLECTION =====
    match /bookings/{bookingId} {
      // Users can read bookings they're involved in
      allow read: if request.auth != null && (request.auth.uid == resource.data.studentId || request.auth.uid == resource.data.landlordId);
      // Authenticated students can create bookings
      allow create: if request.auth != null && request.resource.data.studentId == request.auth.uid;
      // Students can update their own bookings (for payment), Landlords can approve/reject
      allow update: if (request.auth.uid == resource.data.studentId) || (request.auth.uid == resource.data.landlordId);
      // Only landlord can delete (cancel bookings)
      allow delete: if request.auth.uid == resource.data.landlordId;
    }

    // ===== ROOMS COLLECTION =====
    match /rooms/{roomId} {
      // Anyone can read rooms
      allow read: if true;
      // Only landlord who owns the hostel can create/update rooms
      allow create, update: if request.auth != null;
      allow delete: if request.auth != null;
    }

    // ===== SHARED ITEMS COLLECTION =====
    match /sharedItems/{itemId} {
      // Anyone can read shared items
      allow read: if true;
      // Authenticated users can create
      allow create: if request.auth != null;
      // Landlords can update their items
      allow update, delete: if request.auth != null;
    }

    // ===== MAINTENANCE REQUESTS COLLECTION =====
    match /maintenanceRequests/{requestId} {
      // Users can read their own requests
      allow read: if request.auth != null;
      // Authenticated users can create maintenance requests
      allow create: if request.auth != null;
      // Landlords can update (mark as resolved)
      allow update: if request.auth != null;
      // Landlords can delete their requests
      allow delete: if request.auth != null;
    }

    // ===== USER BOOKMARKS/FAVORITES =====
    match /userFavorites/{userId} {
      // Users can only access their own favorites
      allow read, write: if request.auth.uid == userId;
    }

  }
}
