# Environment: 'sandbox' for testing, 'production' for live
MPESA_ENV=sandbox

# Callback URL where M-Pesa will send payment confirmations
# For local development: http://localhost:8080/mpesa/callback
# For production: https://yourdomain.com/mpesa/callback
CALLBACK_URL=https://654c592eb722.ngrok-free.app/api/mpesa/callback

# ===== FIREBASE CONFIGURATION =====
# Path to Firebase service account JSON file
# Download from Firebase Console > Project Settings > Service Accounts
SERVICE_ACCOUNT_PATH=./serviceAccountKey.json

# ===== SERVER CONFIGURATION =====
PORT=8080

# ===== INSTRUCTIONS =====
# 1. Copy this file to .env and fill in your actual values
# 2. Get M-Pesa credentials:
#    - Go to https://developer.safaricom.co.ke
#    - Create an app in the Daraja developer portal
#    - Copy Consumer Key and Consumer Secret
#    - Get the Passkey from the test credentials section
#
# 3. For local development, use MPESA_ENV=sandbox
#    This uses the sandbox API (https://sandbox.safaricom.co.ke)
#
# 4. To deploy to production:
#    - Set MPESA_ENV=production
#    - Use real M-Pesa credentials
#    - Update CALLBACK_URL to your production domain
#    - Enable HTTPS for your server
#
# 5. Test the integration:
#    - POST to /mpesa/initiate-payment with { bookingId, phoneNumber, amount }
#    - Use /mpesa/simulate to test callbacks in sandbox mode
